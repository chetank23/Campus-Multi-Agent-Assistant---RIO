# Frontend environment variables — copy to .env.local for local development
# NEVER commit .env.local

# Backend API base URL:
# - In local development: defaults to '/api' which is proxied to http://localhost:8000 by Vite.
# - In production with Netlify reverse proxy (recommended): leave unset or set to '/api'.
# - In production with direct cross-origin backend: set to your verified backend origin (e.g., https://your-service.onrender.com).
# VITE_API_BASE_URL=
