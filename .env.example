# ─── Application Database (Development) ─────────────────────────
# Primary database URL used by the backend application in development.
DATABASE_URL=postgresql+psycopg://campus_user:yourpassword@localhost:5432/campus_ai

# ─── Test Database (MANDATORY FOR RUNNING TESTS) ─────────────────
# Tests NEVER execute against the development database and will fail closed if this is missing.
# TEST_DATABASE_URL must point to an isolated test database satisfying these safety rules:
# 1. The target database name must explicitly contain 'test' (e.g. 'campus_ai_test').
# 2. The target database name must NOT match the development database in DATABASE_URL.
# 3. Tests will create and operate exclusively in an isolated schema ('test_schema').
TEST_DATABASE_URL=postgresql+psycopg://campus_user:yourpassword@localhost:5432/campus_ai_test

# ─── Destructive Operation Safeguards ───────────────────────────
# Development database reset and truncate operations are blocked by default.
# Set CONFIRM_DB_RESET=yes only when intentionally running reset_db.py or scripts/reset_database.py.
# Set CONFIRM_DEV_SEED_RESET=yes only when intentionally running scripts/seed_database.py against development.
CONFIRM_DB_RESET=no
CONFIRM_DEV_SEED_RESET=no

# ─── JWT Authentication ─────────────────────────────────────────
SECRET_KEY=your-32-byte-random-secret-key-here
JWT_ACCESS_EXPIRY_MIN=20
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Celery / Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI Agents (Claude / Anthropic) ─────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Environment ────────────────────────────────────────────────
ENV=development
